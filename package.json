{
  "name": "gunluk-asistan",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-gunluk \"node --test tests/firestore.test.cjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-gunluk",
    "preview": "node tests/preview.cjs",
    "test:ui": "node tests/personal-ui.cjs && node tests/team-ui.cjs",
    "test:feedback": "node tests/feedback-ui.cjs",
    "test:media": "node tests/media-ui.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0",
    "playwright": "1.62.1"
  }
}
